import os
import logging
import sqlite3
from pathlib import Path
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import Command
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
import asyncio

# --- НАСТРОЙКА ПУТИ К БАЗЕ ДАННЫХ ---
DATA_DIR = Path(os.environ.get("DATA_DIR", "/app/data"))
try:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    DB_PATH = str(DATA_DIR / "bot_database.db")
except Exception:
    DB_PATH = "bot_database.db"  # Для локального запуска

TOKEN = os.getenv("BOT_TOKEN")
bot = Bot(token=TOKEN)
dp = Dispatcher()

def init_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('''CREATE TABLE IF NOT EXISTS users (
        telegram_id INTEGER PRIMARY KEY,
        nickname TEXT UNIQUE
    )''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS answers (
        telegram_id INTEGER,
        q_key TEXT,
        answer_index INTEGER,
        PRIMARY KEY (telegram_id, q_key)
    )''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS meta (
        key TEXT PRIMARY KEY,
        value TEXT
    )''')
    conn.commit()
    conn.close()

def migrate_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("PRAGMA table_info(users)")
    cols = [row[1] for row in cursor.fetchall()]
    if 'age' not in cols:
        cursor.execute("ALTER TABLE users ADD COLUMN age INTEGER")
    if 'gender' not in cols:
        cursor.execute("ALTER TABLE users ADD COLUMN gender TEXT")
    if 'consent' not in cols:
        cursor.execute("ALTER TABLE users ADD COLUMN consent INTEGER DEFAULT 0")
    cursor.execute("SELECT value FROM meta WHERE key = 'version'")
    row = cursor.fetchone()
    version = int(row[0]) if row else 1
    if version < 2:
        cursor.execute("DELETE FROM answers WHERE q_key IN ('l6', 'l11')")
        cursor.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('version', '2')")
    conn.commit()
    conn.close()

def update_user(telegram_id, **fields):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('INSERT OR IGNORE INTO users (telegram_id) VALUES (?)', (telegram_id,))
    if fields:
        cols = ", ".join(f"{k} = ?" for k in fields)
        vals = list(fields.values()) + [telegram_id]
        cursor.execute(f'UPDATE users SET {cols} WHERE telegram_id = ?', vals)
    conn.commit()
    conn.close()

def get_user_full(telegram_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('SELECT nickname, age, gender, consent FROM users WHERE telegram_id = ?', (telegram_id,))
    row = cursor.fetchone()
    conn.close()
    if not row:
        return None
    return {'nickname': row[0], 'age': row[1], 'gender': row[2], 'consent': row[3]}

def delete_user(telegram_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('DELETE FROM answers WHERE telegram_id = ?', (telegram_id,))
    cursor.execute('DELETE FROM users WHERE telegram_id = ?', (telegram_id,))
    conn.commit()
    conn.close()

def get_user_nickname(telegram_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('SELECT nickname FROM users WHERE telegram_id = ?', (telegram_id,))
    result = cursor.fetchone()
    conn.close()
    return result[0] if result else None

def get_user_by_nickname(nickname):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('SELECT telegram_id FROM users WHERE LOWER(nickname) = LOWER(?)', (nickname,))
    result = cursor.fetchone()
    conn.close()
    return result[0] if result else None

def clear_user_answers(telegram_id, prefix='q'):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('DELETE FROM answers WHERE telegram_id = ? AND q_key LIKE ?', (telegram_id, prefix + '%'))
    conn.commit()
    conn.close()

def save_answer(telegram_id, q_key, answer_index):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('INSERT OR REPLACE INTO answers (telegram_id, q_key, answer_index) VALUES (?, ?, ?)', (telegram_id, q_key, answer_index))
    conn.commit()
    conn.close()

def get_user_answers(telegram_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('SELECT q_key, answer_index FROM answers WHERE telegram_id = ?', (telegram_id,))
    results = cursor.fetchall()
    conn.close()
    return {row[0]: row[1] for row in results}

def get_pool_users(exclude_id, prefix):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('''
        SELECT DISTINCT u.telegram_id
        FROM users u
        INNER JOIN answers a ON u.telegram_id = a.telegram_id
        WHERE u.telegram_id != ?
          AND a.q_key LIKE ?
          AND u.nickname IS NOT NULL
    ''', (exclude_id, prefix + '%'))
    rows = cursor.fetchall()
    conn.close()
    return [r[0] for r in rows]

def calc_compatibility(ans_a, ans_b, questions):
    score = 0
    total = 0
    for k in questions.keys():
        if k in ans_a and k in ans_b:
            total += 1
            if ans_a[k] == ans_b[k]:
                score += 1
    percent = round((score / total) * 100) if total > 0 else 0
    return score, total, percent

class Form(StatesGroup):
    waiting_for_nickname = State()
    waiting_for_age = State()
    waiting_for_gender = State()
    waiting_for_friend_nickname = State()
    waiting_for_libido_friend_nickname = State()

