# ... (ОСТАЛЬНЫЕ ОБРАБОТЧИКИ СТАРТА И РЕГИСТРАЦИИ) ...
@dp.message(Command("start"))
async def cmd_start(message: types.Message, state: FSMContext):
    await state.clear()
    user_id = message.from_user.id
    user = get_user_full(user_id)
    if not user or not user['consent']:
        text = ("Привет! Это бот для поиска людей по совпадениям.\n\n"
                "Продолжая, ты соглашаешься на обработку твоих ответов, ника, возраста и пола "
                "для работы сервиса. Данные хранятся в БД бота и не передаются третьим лицам. "
                "Ты можешь удалить себя командой /delete_me.")
        await message.answer(text, reply_markup=get_consent_keyboard())
    else:
        await proceed_anketa(message, user_id, state)

@dp.callback_query(F.data == "consent_agree")
async def consent_agree(callback: types.CallbackQuery, state: FSMContext):
    user_id = callback.from_user.id
    update_user(user_id, consent=1)
    await proceed_anketa(callback.message, user_id, state)

async def proceed_anketa(message: types.Message, user_id: int, state: FSMContext):
    user = get_user_full(user_id)
    if not user or not user['nickname']:
        await state.set_state(Form.waiting_for_nickname)
        await message.answer("Напиши свой никнейм (например, Max):")
    elif not user['age']:
        await state.set_state(Form.waiting_for_age)
        await message.answer("Сколько тебе лет? Напиши число (например, 25):")
    elif not user['gender']:
        await state.set_state(Form.waiting_for_gender)
        await message.answer("Укажи свой пол:", reply_markup=get_gender_keyboard())
    else:
        await state.clear()
        await message.answer(f"Привет, {user['nickname']}! Выбери действие:", reply_markup=get_main_keyboard())

@dp.message(Form.waiting_for_nickname)
async def process_nickname(message: types.Message, state: FSMContext):
    if not message.text: return await message.answer("Пришли текстом, пожалуйста.")
    nickname = message.text.strip()
    if not nickname: return await message.answer("Никнейм не может быть пустым. Напиши ник:")
    update_user(message.from_user.id, nickname=nickname)
    await proceed_anketa(message, message.from_user.id, state)

@dp.message(Form.waiting_for_age)
async def process_age(message: types.Message, state: FSMContext):
    if not message.text: return await message.answer("Пришли число текстом, пожалуйста.")
    text = message.text.strip()
    if not text.isdigit(): return await message.answer("Возраст должен быть числом. Попробуй ещё раз:")
    age = int(text)
    if age < 1 or age > 120: return await message.answer("Возраст должен быть от 1 до 120. Попробуй ещё раз:")
    update_user(message.from_user.id, age=age)
    await proceed_anketa(message, message.from_user.id, state)

@dp.callback_query(F.data.startswith("gender_"))
async def process_gender(callback: types.CallbackQuery, state: FSMContext):
    code = callback.data.split("_", 1)[1]
    if code not in ("m", "f"): return await callback.answer("Некорректный пол")
    gender = "М" if code == "m" else "Ж"
    update_user(callback.from_user.id, gender=gender)
    await proceed_anketa(callback.message, callback.from_user.id, state)

# --- СИСТЕМА ОПЛАТЫ ЗА ИСПОЛЬЗОВАНИЕ (ПОПЫТКИ) ---
async def check_libido_access(message_or_callback, user_id):
    user = get_user_full(user_id)
    balance = user.get('libido_balance', 0)
    
    if balance > 0:
        # Списываем 1 попытку
        update_user(user_id, libido_balance=balance - 1)
        return True
    else:
        # Отправляем счет на покупку пакета из 5 попыток за 25 Stars
        prices = [LabeledPrice(label="Пакет на 5 попыток Либидо", amount=25)] 
        await bot.send_invoice(
            chat_id=user_id,
            title="Пакет Либидо",
            description="Вы получите 5 использований любых функций Либидо (тест, топ, поиск).",
            payload="libido_pack_payload",
            provider_token="", 
            currency="XTR", # Telegram Stars
            prices=prices
        )
        return False

@dp.pre_checkout_query()
async def process_pre_checkout_query(pre_checkout_query: types.PreCheckoutQuery):
    await bot.answer_pre_checkout_query(pre_checkout_query.id, ok=True)

@dp.message(F.successful_payment)
async def process_successful_payment(message: types.Message):
    user = get_user_full(message.from_user.id)
    balance = user.get('libido_balance', 0)
    # Начисляем 5 попыток
    update_user(message.from_user.id, libido_balance=balance + 5)
    await message.answer("✅ Оплата прошла успешно! Вам начислено 5 попыток для раздела Либидо.", reply_markup=get_main_keyboard())

@dp.callback_query(F.data == "start_libido")
async def process_start_libido(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    if not get_user_nickname(user_id):
        return await callback.message.edit_text("Сначала напиши /start и укажи ник.")
        
    if not await check_libido_access(callback.message, user_id):
        return 
        
    clear_user_answers(user_id, 'l')
    await send_question_libido(callback.message, "l1")

@dp.callback_query(F.data == "top_10_l")
async def show_top_10_l(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    if not await check_libido_access(callback.message, user_id):
        return
    await callback.answer("Ищу совпадения...")
    await _show_top(callback, 'l', QUESTIONS_LIBIDO, 'Либидо')

@dp.callback_query(F.data == "find_match_libido")
async def ask_libido_friend_nickname(callback: types.CallbackQuery, state: FSMContext):
    user_id = callback.from_user.id
    if not await check_libido_access(callback.message, user_id):
        return
        
    await state.set_state(Form.waiting_for_libido_friend_nickname)
    await callback.message.edit_text("Введи часть никнейма для поиска по Либидо:")

# --- ОСТАЛЬНОЙ ФУНКЦИОНАЛ ---
@dp.callback_query(F.data == "my_answers")
async def show_answers_callback(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    answers = get_user_answers(user_id)
    filtered = {k: v for k, v in answers.items() if k.startswith('q')}
    if not filtered: return await callback.message.edit_text("Ты еще не прошел тест 24 вопроса. Нажми /start и выбери тест.")
    sorted_keys = sorted(filtered.keys(), key=lambda k: int(k.replace("q", "")))
    text = "Твои ответы (тест 24):\n\n"
    for q_key in sorted_keys:
        ans_idx = filtered[q_key]
        try: option_text = QUESTIONS[q_key]["options"][ans_idx]
        except: option_text = "—"
        text += f"Вопрос {q_key.replace('q', '')}: {option_text}\n"
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[[types.InlineKeyboardButton(text="Назад в меню", callback_data="back_to_menu")]])
    await callback.message.edit_text(text, reply_markup=keyboard)

@dp.callback_query(F.data == "my_answers_libido")
async def show_libido_answers_callback(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    answers = get_user_answers(user_id)
    filtered = {k: v for k, v in answers.items() if k.startswith('l')}
    if not filtered: return await callback.message.edit_text("Ты еще не прошел тест Либидо.")
    sorted_keys = sorted(filtered.keys(), key=lambda k: int(k.replace("l", "")))
    text = "Твои ответы (тест Либидо):\n\n"
    for l_key in sorted_keys:
        ans_idx = filtered[l_key]
        try: option_text = QUESTIONS_LIBIDO[l_key]["options"][ans_idx]
        except: option_text = "—"
        text += f"Вопрос {l_key.replace('l', '')}: {option_text}\n"
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[[types.InlineKeyboardButton(text="Назад в меню", callback_data="back_to_menu")]])
    await callback.message.edit_text(text, reply_markup=keyboard)

@dp.callback_query(F.data == "top_10_q")
async def show_top_10_q(callback: types.CallbackQuery):
    await callback.answer("Ищу совпадения...")
    await _show_top(callback, 'q', QUESTIONS, '24 вопроса')

async def _show_top(callback: types.CallbackQuery, prefix, questions, test_name):
    user_id = callback.from_user.id
    my_answers = get_user_answers(user_id)
    my_answers = {k: v for k, v in my_answers.items() if k.startswith(prefix)}
    if not my_answers: return await callback.message.edit_text(f"Ты ещё не прошёл тест {test_name}. Сначала пройди его.", reply_markup=get_main_keyboard())
    pool_ids = get_pool_users(user_id, prefix)
    if not pool_ids: return await callback.message.edit_text(f"Пока никто, кроме тебя, не прошёл тест {test_name}.", reply_markup=get_main_keyboard())
    matches = []
    for uid in pool_ids:
        other_answers = get_user_answers(uid)
        other_answers = {k: v for k, v in other_answers.items() if k.startswith(prefix)}
        score, total, percent = calc_compatibility(my_answers, other_answers, questions)
        if total > 0:
            other_user = get_user_full(uid)
            if not other_user: continue
            matches.append({'telegram_id': uid, 'nickname': other_user['nickname'], 'age': other_user['age'], 'gender': other_user['gender'], 'score': score, 'total': total, 'percent': percent})
    matches.sort(key=lambda x: (x['percent'], x['total']), reverse=True)
    top = matches[:10]
    if not top: return await callback.message.edit_text(f"Не удалось найти совпадений.", reply_markup=get_main_keyboard())
    
    lines = [f"🏆 Топ-{len(top)} совпадений ({test_name}):\n"]
    buttons = []
    for i, m in enumerate(top, 1):
        parts = [m['nickname']]
        if m['gender']: parts.append(m['gender'])
        if m['age']: parts.append(str(m['age']))
        lines.append(f"{i}. {', '.join(parts)} — {m['percent']}% ({m['score']}/{m['total']})")
        buttons.append([types.InlineKeyboardButton(text=f"✉️ Написать {m['nickname']}", callback_data=f"msgto_{m['telegram_id']}")])
    
    buttons.append([types.InlineKeyboardButton(text="Назад в меню", callback_data="back_to_menu")])
    await callback.message.edit_text("\n".join(lines), reply_markup=types.InlineKeyboardMarkup(inline_keyboard=buttons))

@dp.callback_query(F.data == "find_match")
async def ask_friend_nickname(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(Form.waiting_for_friend_nickname)
    await callback.message.edit_text("Введи часть никнейма для поиска по 24 вопросам:")

@dp.message(Form.waiting_for_friend_nickname)
async def process_friend_nickname(message: types.Message, state: FSMContext):
    query = message.text.strip()
    matches = search_users_by_nickname(query)
    matches = [m for m in matches if m['telegram_id'] != message.from_user.id]
    if not matches: return await message.answer(f"Пользователи с ником, содержащим «{query}», не найдены.", reply_markup=get_main_keyboard())
    buttons = []
    for m in matches[:15]:
        label = m['nickname'] + (f", {m['gender']}" if m['gender'] else "") + (f", {m['age']}" if m['age'] else "")
        buttons.append([types.InlineKeyboardButton(text=label, callback_data=f"selmatch_q_{m['telegram_id']}")])
    buttons.append([types.InlineKeyboardButton(text="Отмена", callback_data="back_to_menu")])
    await message.answer(f"Найдено несколько пользователей по запросу «{query}». Выбери нужного:", reply_markup=types.InlineKeyboardMarkup(inline_keyboard=buttons))
    await state.clear()

@dp.message(Form.waiting_for_libido_friend_nickname)
async def process_libido_friend_nickname(message: types.Message, state: FSMContext):
    query = message.text.strip()
