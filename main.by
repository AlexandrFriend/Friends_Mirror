def get_main_keyboard():
    return types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="Пройти тест 24 вопроса", callback_data="start_24")],
        [types.InlineKeyboardButton(text="Пройти тест Либидо", callback_data="start_libido")],
        [types.InlineKeyboardButton(text="Мои ответы (24)", callback_data="my_answers")],
        [types.InlineKeyboardButton(text="Мои ответы (Либидо)", callback_data="my_answers_libido")],
        [types.InlineKeyboardButton(text="🏆 Топ-10 (24)", callback_data="top_10_q")],
        [types.InlineKeyboardButton(text="🏆 Топ-10 (Либидо)", callback_data="top_10_l")],
        [types.InlineKeyboardButton(text="Совместимость по нику (24)", callback_data="find_match")],
        [types.InlineKeyboardButton(text="Совместимость по нику (Либидо)", callback_data="find_match_libido")]
    ])

def get_consent_keyboard():
    return types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="Согласен", callback_data="consent_agree")]
    ])

def get_gender_keyboard():
    return types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="М", callback_data="gender_m"),
         types.InlineKeyboardButton(text="Ж", callback_data="gender_f")]
    ])

@dp.message(Command("start"))
async def cmd_start(message: types.Message, state: FSMContext):
    await state.clear()
    user_id = message.from_user.id
    user = get_user_full(user_id)
    if not user or not user['consent']:
        text = ("Привет! Это бот для поиска людей по совместимости.\n\n"
                "Продолжая, ты соглашаешься на обработку твоих ответов, ника, возраста и пола "
                "для работы сервиса. Данные хранятся в БД бота и не передаются третьим лицам. "
                "Ты можешь удалить себя командой /delete_me.")
        await message.answer(text, reply_markup=get_consent_keyboard())
    else:
        await proceed_anketa(message, user_id, state)

@dp.callback_query(F.data == "consent_agree")
async def consent_agree(callback: types.CallbackQuery, state: FSMContext):
    user_id = callback.from_user.id
    update_user(user_id, consent=1)
    await proceed_anketa(callback.message, user_id, state)

async def proceed_anketa(message: types.Message, user_id: int, state: FSMContext):
    user = get_user_full(user_id)
    if not user or not user['nickname']:
        await state.set_state(Form.waiting_for_nickname)
        await message.answer("Напиши свой никнейм (например, Max):")
    elif not user['age']:
        await state.set_state(Form.waiting_for_age)
        await message.answer("Сколько тебе лет? Напиши число (например, 25):")
    elif not user['gender']:
        await state.set_state(Form.waiting_for_gender)
        await message.answer("Укажи свой пол:", reply_markup=get_gender_keyboard())
    else:
        await state.clear()
        await message.answer(f"Привет, {user['nickname']}! Выбери действие:", reply_markup=get_main_keyboard())

@dp.message(Form.waiting_for_nickname)
async def process_nickname(message: types.Message, state: FSMContext):
    if not message.text:
        await message.answer("Пришли текстом, пожалуйста.")
        return
    nickname = message.text.strip()
    if not nickname:
        await message.answer("Никнейм не может быть пустым. Напиши ник:")
        return
    user_id = message.from_user.id
    update_user(user_id, nickname=nickname)
    await proceed_anketa(message, user_id, state)

@dp.message(Form.waiting_for_age)
async def process_age(message: types.Message, state: FSMContext):
    if not message.text:
        await message.answer("Пришли число текстом, пожалуйста.")
        return
    text = message.text.strip()
    if not text.isdigit():
        await message.answer("Возраст должен быть числом. Попробуй ещё раз:")
        return
    age = int(text)
    if age < 1 or age > 120:
        await message.answer("Возраст должен быть от 1 до 120. Попробуй ещё раз:")
        return
    user_id = message.from_user.id
    update_user(user_id, age=age)
    await proceed_anketa(message, user_id, state)

@dp.callback_query(F.data.startswith("gender_"))
async def process_gender(callback: types.CallbackQuery, state: FSMContext):
    code = callback.data.split("_", 1)[1]
    if code not in ("m", "f"):
        await callback.answer("Некорректный пол")
        return
    gender = "М" if code == "m" else "Ж"
    user_id = callback.from_user.id
    update_user(user_id, gender=gender)
    await proceed_anketa(callback.message, user_id, state)

@dp.callback_query(F.data == "start_24")
async def process_start_24(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    nickname = get_user_nickname(user_id)
    if not nickname:
        await callback.message.edit_text("Сначала напиши /start и укажи ник.")
        return
    clear_user_answers(user_id, 'q')
    await send_question_24(callback.message, "q1")

@dp.callback_query(F.data == "start_libido")
async def process_start_libido(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    nickname = get_user_nickname(user_id)
    if not nickname:
        await callback.message.edit_text("Сначала напиши /start и укажи ник.")
        return
    clear_user_answers(user_id, 'l')
    await send_question_libido(callback.message, "l1")

@dp.callback_query(F.data == "my_answers")
async def show_answers_callback(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    answers = get_user_answers(user_id)
    filtered = {k: v for k, v in answers.items() if k.startswith('q')}
    if not filtered:
        await callback.message.edit_text("Ты еще не прошел тест 24 вопроса. Нажми /start и выбери тест.")
        return
    sorted_keys = sorted(filtered.keys(), key=lambda k: int(k.replace("q", "")))
    text = "Твои ответы (тест 24):\n\n"
    for q_key in sorted_keys:
        ans_idx = filtered[q_key]
        try:
            option_text = QUESTIONS[q_key]["options"][ans_idx]
        except (KeyError, IndexError):
            option_text = "—"
        q_num = q_key.replace("q", "")
        text += f"Вопрос {q_num}: {option_text}\n"
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="Назад в меню", callback_data="back_to_menu")]
    ])
    await callback.message.edit_text(text, reply_markup=keyboard)

@dp.callback_query(F.data == "my_answers_libido")
async def show_libido_answers_callback(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    answers = get_user_answers(user_id)
    filtered = {k: v for k, v in answers.items() if k.startswith('l')}
    if not filtered:
        await callback.message.edit_text("Ты еще не прошел тест Либидо. Нажми /start и выбери тест.")
        return
    sorted_keys = sorted(filtered.keys(), key=lambda k: int(k.replace("l", "")))
    text = "Твои ответы (тест Либидо):\n\n"
    for l_key in sorted_keys:
        ans_idx = filtered[l_key]
        try:
            option_text = QUESTIONS_LIBIDO[l_key]["options"][ans_idx]
        except (KeyError, IndexError):
            option_text = "—"
        l_num = l_key.replace("l", "")
        text += f"Вопрос {l_num}: {option_text}\n"
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="Назад в меню", callback_data="back_to_menu")]
    ])
    await callback.message.edit_text(text, reply_markup=keyboard)

@dp.callback_query(F.data == "top_10_q")
async def show_top_10_q(callback: types.CallbackQuery):
    await callback.answer("Ищу совпадения...")
    await _show_top(callback, 'q', QUESTIONS, '24 вопроса')

@dp.callback_query(F.data == "top_10_l")
async def show_top_10_l(callback: types.CallbackQuery):
    await callback.answer("Ищу совпадения...")
    await _show_top(callback, 'l', QUESTIONS_LIBIDO, 'Либидо')

async def _show_top(callback: types.CallbackQuery, prefix, questions, test_name):
    user_id = callback.from_user.id
    my_answers = get_user_answers(user_id)
    my_answers = {k: v for k, v in my_answers.items() if k.startswith(prefix)}
    if not my_answers:
        await callback.message.edit_text(
            f"Ты ещё не прошёл тест {test_name}. Сначала пройди его.",
            reply_markup=get_main_keyboard()
        )
        return
    pool_ids = get_pool_users(user_id, prefix)
    if not pool_ids:
        await callback.message.edit_text(
            f"Пока никто, кроме тебя, не прошёл тест {test_name}. "
            "Пригласи друзей или попробуй позже.",
            reply_markup=get_main_keyboard()
        )
        return
    matches = []
    for uid in pool_ids:
        other_answers = get_user_answers(uid)
        other_answers = {k: v for k, v in other_answers.items() if k.startswith(prefix)}
        score, total, percent = calc_compatibility(my_answers, other_answers, questions)
        if total > 0:
            other_user = get_user_full(uid)
            if not other_user:
                continue
            matches.append({
                'nickname': other_user['nickname'],
                'age': other_user['age'],
                'gender': other_user['gender'],
                'score': score,
                'total': total,
                'percent': percent,
            })
    matches.sort(key=lambda x: (x['percent'], x['total']), reverse=True)
    top = matches[:10]
    if not top:
        await callback.message.edit_text(
            f"Не удалось найти совпадений по тесту {test_name}. Попробуй позже.",
            reply_markup=get_main_keyboard()
        )
        return
    lines = [f"🏆 Топ-{len(top)} совместимости ({test_name}):\n"]
    for i, m in enumerate(top, 1):
        parts = [m['nickname']]
        if m['gender']:
            parts.append(m['gender'])
        if m['age']:
            parts.append(str(m['age']))
        label = ", ".join(parts)
        lines.append(f"{i}. {label} — {m['percent']}% ({m['score']}/{m['total']})")
    await callback.message.edit_text(
        "\n".join(lines),
        reply_markup=get_main_keyboard()
    )

@dp.callback_query(F.data == "find_match")
async def ask_friend_nickname(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(Form.waiting_for_friend_nickname)
    await callback.message.edit_text("Введи никнейм друга для сравнения по 24 вопросам:")

@dp.message(Form.waiting_for_friend_nickname)
async def process_friend_nickname(message: types.Message, state: FSMContext):
    if not message.text:
        await message.answer("Пришли текстом, пожалуйста.", reply_markup=get_main_keyboard())
        await state.clear()
        return
    friend_nickname = message.text.strip()
    user_id = message.from_user.id
    friend_id = get_user_by_nickname(friend_nickname)
    if not friend_id:
        await message.answer(
            f"Пользователь с ником «{friend_nickname}» не найден. Проверь написание или напиши /start.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    if friend_id == user_id:
        await message.answer(
            "Это твой собственный ник. Введи ник друга, с кем хочешь сравнить.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    ans_a = get_user_answers(user_id)
    ans_b = get_user_answers(friend_id)
    ans_a = {k: v for k, v in ans_a.items() if k.startswith('q')}
    ans_b = {k: v for k, v in ans_b.items() if k.startswith('q')}
    if not ans_b:
        await message.answer(
            f"Пользователь {friend_nickname} ещё не прошел тест 24 вопроса.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    if not ans_a:
        await message.answer(
            "Ты ещё не прошел тест 24 вопроса. Сначала пройди его.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    score, total, percent = calc_compatibility(ans_a, ans_b, QUESTIONS)
    await message.answer(
        f"Совместимость (24 вопроса) с {friend_nickname}:\n"
        f"🎯 {percent}%\n\n"
        f"(Совпало {score} из {total} общих ответов)",
        reply_markup=get_main_keyboard()
    )
    await state.clear()

@dp.callback_query(F.data == "find_match_libido")
async def ask_libido_friend_nickname(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(Form.waiting_for_libido_friend_nickname)
    await callback.message.edit_text("Введи никнейм друга для сравнения по Либидо:")

@dp.message(Form.waiting_for_libido_friend_nickname)
async def process_libido_friend_nickname(message: types.Message, state: FSMContext):
    if not message.text:
        await message.answer("Пришли текстом, пожалуйста.", reply_markup=get_main_keyboard())
        await state.clear()
        return
    friend_nickname = message.text.strip()
    user_id = message.from_user.id
    friend_id = get_user_by_nickname(friend_nickname)
    if not friend_id:
        await message.answer(
            f"Пользователь с ником «{friend_nickname}» не найден. Проверь написание или напиши /start.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    if friend_id == user_id:
        await message.answer(
            "Это твой собственный ник. Введи ник друга, с кем хочешь сравнить.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    ans_a = get_user_answers(user_id)
    ans_b = get_user_answers(friend_id)
    ans_a = {k: v for k, v in ans_a.items() if k.startswith('l')}
    ans_b = {k: v for k, v in ans_b.items() if k.startswith('l')}
    if not ans_b:
        await message.answer(
            f"Пользователь {friend_nickname} ещё не прошел тест Либидо.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    if not ans_a:
        await message.answer(
            "Ты ещё не прошел тест Либидо. Сначала пройди его.",
            reply_markup=get_main_keyboard()
        )
        await state.clear()
        return
    score, total, percent = calc_compatibility(ans_a, ans_b, QUESTIONS_LIBIDO)
    await message.answer(
        f"Совместимость (Либидо) с {friend_nickname}:\n"
        f"🎯 {percent}%\n\n"
        f"(Совпало {score} из {total} общих ответов)",
        reply_markup=get_main_keyboard()
    )
    await state.clear()

@dp.callback_query(F.data == "back_to_menu")
async def back_to_menu(callback: types.CallbackQuery, state: FSMContext):
    await state.clear()
    user_id = callback.from_user.id
    nickname = get_user_nickname(user_id) or "друг"
    await callback.message.edit_text(
        f"Привет, {nickname}! Выбери действие:",
        reply_markup=get_main_keyboard()
    )

async def send_question_24(message: types.Message, q_key: str):
    q_data = QUESTIONS.get(q_key)
    if not q_data:
        return
    question_text = q_data["text"]
    options = q_data["options"]
    buttons = [[types.InlineKeyboardButton(text=opt, callback_data=f"ans_{q_key}_{i}")] for i, opt in enumerate(options)]
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=buttons)
    q_num = q_key.replace("q", "")
    await message.edit_text(f"Вопрос {q_num}: {question_text}", reply_markup=keyboard)

async def send_question_libido(message: types.Message, l_key: str):
    l_data = QUESTIONS_LIBIDO.get(l_key)
    if not l_data:
        return
    question_text = l_data["text"]
    options = l_data["options"]
    buttons = [[types.InlineKeyboardButton(text=opt, callback_data=f"lans_{l_key}_{i}")] for i, opt in enumerate(options)]
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=buttons)
    l_num = l_key.replace("l", "")
    await message.edit_text(f"Вопрос {l_num} (Либидо): {question_text}", reply_markup=keyboard)

@dp.callback_query(F.data.startswith("ans_"))
async def process_answer_24(callback: types.CallbackQuery):
    data = callback.data.split("_")
    q_key = data[1]
    answer_index = int(data[2])
    user_id = callback.from_user.id
    save_answer(user_id, q_key, answer_index)
    q_num = int(q_key.replace("q", ""))
    next_q_key = f"q{q_num + 1}"
    if next_q_key in QUESTIONS:
        await send_question_24(callback.message, next_q_key)
    else:
        keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
            [types.InlineKeyboardButton(text="Посмотреть мои ответы (24)", callback_data="my_answers")]
        ])
        await callback.message.edit_text("🎉 Поздравляю! Ты ответил на все 24 вопроса. Тест завершен!", reply_markup=keyboard)

@dp.callback_query(F.data.startswith("lans_"))
async def process_answer_libido(callback: types.CallbackQuery):
    data = callback.data.split("_")
    l_key = data[1]
    answer_index = int(data[2])
    user_id = callback.from_user.id
    save_answer(user_id, l_key, answer_index)
    l_num = int(l_key.replace("l", ""))
    next_l_key = f"l{l_num + 1}"
    if next_l_key in QUESTIONS_LIBIDO:
        await send_question_libido(callback.message, next_l_key)
    else:
        keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
            [types.InlineKeyboardButton(text="Посмотреть мои ответы (Либидо)", callback_data="my_answers_libido")]
        ])
        await callback.message.edit_text("🎉 Поздравляю! Ты ответил на все 11 вопросов теста Либидо. Тест завершен!", reply_markup=keyboard)

@dp.message(Command("profile"))
async def cmd_profile(message: types.Message, state: FSMContext):
    await state.clear()
    user = get_user_full(message.from_user.id)
    if not user or not user['nickname']:
        await message.answer("Сначала пройди регистрацию: /start")
        return
    age = user['age'] if user['age'] is not None else "не указан"
    gender = user['gender'] if user['gender'] else "не указан"
    text = f"👤 Твой профиль:\n\nНик: {user['nickname']}\nВозраст: {age}\nПол: {gender}"
    await message.answer(text, reply_markup=get_main_keyboard())

@dp.message(Command("delete_me"))
async def cmd_delete_me(message: types.Message, state: FSMContext):
    await state.clear()
    delete_user(message.from_user.id)
    await message.answer("Твои данные удалены. Если захочешь вернуться — напиши /start.")

async def main():
    init_db()
    migrate_db()
    await bot.delete_webhook(drop_pending_updates=True) 
    await dp.start_polling(bot)

if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    asyncio.run(main())
