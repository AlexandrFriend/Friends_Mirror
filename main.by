@dp.callback_query(F.data.startswith("selmatch_"))
async def process_selected_match(callback: types.CallbackQuery):
    data = callback.data.split("_")
    prefix = data[1]
    target_id = int(data[2])
    user_id = callback.from_user.id
    target_nick = get_user_nickname(target_id) or "Пользователь"
    
    ans_a = {k: v for k, v in get_user_answers(user_id).items() if k.startswith(prefix)}
    ans_b = {k: v for k, v in get_user_answers(target_id).items() if k.startswith(prefix)}
    
    if not ans_b: return await callback.answer(f"{target_nick} еще не прошел этот тест.", show_alert=True)
    if not ans_a: return await callback.answer("Ты ещё не прошел этот тест.", show_alert=True)
        
    questions = QUESTIONS if prefix == 'q' else QUESTIONS_LIBIDO
    test_name = "24 вопроса" if prefix == 'q' else "Либидо"
    score, total, percent = calc_compatibility(ans_a, ans_b, questions)
    
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text=f"✉️ Написать {target_nick}", callback_data=f"msgto_{target_id}")],
        [types.InlineKeyboardButton(text="В меню", callback_data="back_to_menu")]
    ])
    await callback.message.edit_text(f"Совпадение ({test_name}) с {target_nick}:\n🎯 {percent}%\n\n(Совпало {score} из {total} общих ответов)", reply_markup=keyboard)

@dp.callback_query(F.data.startswith("msgto_"))
async def start_writing_message(callback: types.CallbackQuery, state: FSMContext):
    target_id = int(callback.data.split("_")[1])
    if target_id == callback.from_user.id: return await callback.answer("Нельзя написать самому себе!", show_alert=True)
    target_nick = get_user_nickname(target_id) or "Пользователь"
    await state.update_data(target_id=target_id, target_nick=target_nick)
    await state.set_state(Form.waiting_for_msg_text)
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[[types.InlineKeyboardButton(text="Отмена", callback_data="back_to_menu")]])
    await callback.message.edit_text(f"✉️ Напиши сообщение для пользователя <b>{target_nick}</b>.\nОн получит его от бота анонимно.", reply_markup=keyboard, parse_mode="HTML")

@dp.message(Form.waiting_for_msg_text)
async def send_message_to_user(message: types.Message, state: FSMContext):
    if not message.text: return await message.answer("Пожалуйста, отправь текст сообщения.")
    data = await state.get_data()
    target_id = data.get('target_id')
    sender_nick = get_user_nickname(message.from_user.id) or "Кто-то"
    
    reply_kb = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="✉️ Ответить", callback_data=f"msgto_{message.from_user.id}")]
    ])
    
    try:
        await bot.send_message(
            target_id, 
            f"💌 <b>Новое сообщение!</b>\n\nОт: <b>{sender_nick}</b>\n\n{message.text}",
            reply_markup=reply_kb,
            parse_mode="HTML"
        )
        await message.answer("✅ Сообщение успешно отправлено!", reply_markup=get_main_keyboard())
    except Exception as e:
        logging.error(f"Ошибка отправки {target_id}: {e}")
        await message.answer("⚠️ Не удалось отправить сообщение (возможно, заблокирован бот).", reply_markup=get_main_keyboard())
    await state.clear()

@dp.callback_query(F.data == "back_to_menu")
async def back_to_menu(callback: types.CallbackQuery, state: FSMContext):
    await state.clear()
    user_id = callback.from_user.id
    nickname = get_user_nickname(user_id) or "друг"
    await callback.message.edit_text(f"Привет, {nickname}! Выбери действие:", reply_markup=get_main_keyboard())

async def send_question_24(message: types.Message, q_key: str):
    q_data = QUESTIONS.get(q_key)
    if not q_data: return
    buttons = [[types.InlineKeyboardButton(text=opt, callback_data=f"ans_{q_key}_{i}")] for i, opt in enumerate(q_data["options"])]
    await message.edit_text(f"Вопрос {q_key.replace('q', '')}: {q_data['text']}", reply_markup=types.InlineKeyboardMarkup(inline_keyboard=buttons))

async def send_question_libido(message: types.Message, l_key: str):
    l_data = QUESTIONS_LIBIDO.get(l_key)
    if not l_data: return
    buttons = [[types.InlineKeyboardButton(text=opt, callback_data=f"lans_{l_key}_{i}")] for i, opt in enumerate(l_data["options"])]
    await message.edit_text(f"Вопрос {l_key.replace('l', '')} (Либидо): {l_data['text']}", reply_markup=types.InlineKeyboardMarkup(inline_keyboard=buttons))

@dp.callback_query(F.data.startswith("ans_"))
async def process_answer_24(callback: types.CallbackQuery):
    data = callback.data.split("_")
    q_key = data[1]
    save_answer(callback.from_user.id, q_key, int(data[2]))
    q_num = int(q_key.replace("q", ""))
    next_q = f"q{q_num + 1}"
    if next_q in QUESTIONS:
        await send_question_24(callback.message, next_q)
    else:
        keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
            [types.InlineKeyboardButton(text="Посмотреть ответы (24)", callback_data="my_answers")],
            [types.InlineKeyboardButton(text="🏆 Топ-10 (24)", callback_data="top_10_q")],
            [types.InlineKeyboardButton(text="В меню", callback_data="back_to_menu")]
        ])
        await callback.message.edit_text("🎉 Поздравляю! Ты ответил на все 24 вопроса.", reply_markup=keyboard)

@dp.callback_query(F.data.startswith("lans_"))
async def process_answer_libido(callback: types.CallbackQuery):
    data = callback.data.split("_")
    l_key = data[1]
    save_answer(callback.from_user.id, l_key, int(data[2]))
    l_num = int(l_key.replace("l", ""))
    next_l = f"l{l_num + 1}"
    if next_l in QUESTIONS_LIBIDO:
        await send_question_libido(callback.message, next_l)
    else:
        keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
            [types.InlineKeyboardButton(text="Посмотреть ответы (Либидо)", callback_data="my_answers_libido")],
            [types.InlineKeyboardButton(text="🏆 Топ-10 (Либидо)", callback_data="top_10_l")],
            [types.InlineKeyboardButton(text="В меню", callback_data="back_to_menu")]
        ])
        await callback.message.edit_text("🎉 Поздравляю! Ты ответил на все 11 вопросов Либидо.", reply_markup=keyboard)

@dp.message(Command("profile"))
async def cmd_profile(message: types.Message, state: FSMContext):
    await state.clear()
    user = get_user_full(message.from_user.id)
    if not user or not user['nickname']: return await message.answer("Сначала пройди регистрацию: /start")
    age = user['age'] if user['age'] is not None else "не указан"
    gender = user['gender'] if user['gender'] else "не указан"
    balance = user.get('libido_balance', 0)
    await message.answer(f"👤 Твой профиль:\n\nНик: {user['nickname']}\nВозраст: {age}\nПол: {gender}\n💎 Баланс Либидо: {balance} попыток", reply_markup=get_main_keyboard())

@dp.message(Command("delete_me"))
async def cmd_delete_me(message: types.Message, state: FSMContext):
    await state.clear()
    delete_user(message.from_user.id)
    await message.answer("Твои данные удалены. Если захочешь вернуться — напиши /start.")

async def main():
    init_db()
    migrate_db()
    await bot.delete_webhook(drop_pending_updates=True) 
    await dp.start_polling(bot)

if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    asyncio.run(main())
