import os
import logging
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
import asyncio

TOKEN = os.getenv("BOT_TOKEN")
bot = Bot(token=TOKEN)
dp = Dispatcher()

@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="Пройти тест 24 вопроса", callback_data="start_24")],
        [types.InlineKeyboardButton(text="Пройти тест Либидо", callback_data="start_libido")]
    ])
    await message.answer("Привет! Я бот FriendsMirror. Выбери тест, который хочешь пройти:", reply_markup=keyboard)

@dp.callback_query(lambda c: c.data == "start_24")
async def process_start_24(callback: types.CallbackQuery):
    keyboard = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="В компании", callback_data="q1_0")],
        [types.InlineKeyboardButton(text="В уединении", callback_data="q1_1")]
    ])
    await callback.message.edit_text("Вопрос 1: Как вы предпочитаете проводить свободное время?", reply_markup=keyboard)

@dp.callback_query(lambda c: c.data == "start_libido")
async def process_start_libido(callback: types.CallbackQuery):
    await callback.message.edit_text("Тест Либидо скоро появится здесь! (Это проверка кнопки)")

@dp.callback_query(lambda c: c.data.startswith("q1_"))
async def process_q1(callback: types.CallbackQuery):
    answer = callback.data.split("_")[1]
    text = "В компании" if answer == "0" else "В уединении"
    await callback.message.edit_text(f"Ты выбрал: {text}. Отлично!")

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    asyncio.run(main())
